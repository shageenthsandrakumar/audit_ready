# Copy this file to `.env` and fill in your key. `.env` is gitignored — never commit a real key.

# Groq (free tier, high rate limits) — get a key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional: only needed if you switch the agent back to Gemini.
# GEMINI_API_KEY=your_ai_studio_key_here
